#!/bin/bash

# Function to check the status of the last command and exit if it failed
check_command_status() {
    if [ $? -ne 0 ]; then
        echo "---> ERR: $1. Exiting."
        exit 1
    fi
}

MERGE_MSG=""

while getopts "m:h" opt; do
    case $opt in
        m) MERGE_MSG="$OPTARG" ;;
        h)
            echo "Usage: $(basename "$0") [-m \"merge commit message\"] [source_branch] [target_branch]"
            echo "  -m message   Use this message for the merge commit (then push target branch)."
            echo "  source_branch  Branch to merge (default: current branch, or . for current)"
            echo "  target_branch  Branch to merge into (default: develop)"
            exit 0
            ;;
        \?) echo "Usage: $(basename "$0") [-m message] [source_branch] [target_branch]"; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

push $MERGE_MSG
check_command_status

# Get the current branch name
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Check if the source branch parameter is provided
if [ -z "$1" -o "$1" == "." ]; then
    SOURCE_BRANCH=$CURRENT_BRANCH
else
    SOURCE_BRANCH=$1
fi

# Set the target branch to 'develop' if not provided
if [ -z "$2" ]; then
    TARGET_BRANCH=develop
else
    TARGET_BRANCH=$2
fi

# Step 1: Checkout target branch
git checkout "$TARGET_BRANCH"
check_command_status "Failed to checkout target branch"

# Step 2: Pull the latest changes from the target branch
git pull origin "$TARGET_BRANCH"
check_command_status "Failed to pull latest changes from target branch"

# Step 4: Merge code from the specified branch
git merge "$SOURCE_BRANCH"
check_command_status "Failed to merge code from source branch"

# Step 5: Push code to remote
git push origin "$TARGET_BRANCH"
check_command_status "Failed to push code to remote"

# Step 6: Checkout to the specified branch
git checkout "$SOURCE_BRANCH"
check_command_status "Failed to checkout source branch"
