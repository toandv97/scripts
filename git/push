#!/bin/bash

source common

# This script mimics 'git push', passing all options and arguments through.
# All arguments after the optional msg: -m "your commit msg" are passed to git push.
# USAGE: ./push [-m "commit msg"] [<push-target> [<refspec>...]] [git-push-options...]

COMMIT_MSG=""
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m)
            shift
            if [ -z "$1" ]; then
                echo "Error: -m requires a commit message"
                exit 1
            fi
            COMMIT_MSG="$1"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

info "Checking git status"

status

sep

info "Committing changes"

git add .

if [ -z "$COMMIT_MSG" ]; then
    COMMIT_MSG="Mirror update - automated commit"
fi

git commit -m "$COMMIT_MSG" || info "No changes to commit"

info "Pushing changes with: git push ${ARGS[*]}"
git push "${ARGS[@]}"
check_cmd "Failed to push code to remote"

exit 0
